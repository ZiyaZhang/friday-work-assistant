{
  "name": "dsh-friday",
  "version": "0.1.0",
  "description": "Friday 个人助手：共享飞书清单、工作和上下文",
  "private": true,
  "type": "module",
  "dependencies": {
    "https-proxy-agent": "7.0.6"
  },
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "locale"
  ],
  "license": "MIT"
}
