# ---- 飞书应用（开发者后台 → 凭证与基础信息） ----
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# feishu | lark（国际版）
FEISHU_DOMAIN=feishu
# 机器人在群里被 @ 时显示的名字，仅用于日志和提示
FRIDAY_BOT_NAME=Friday

# ---- 出网代理（只能经代理出网的环境必填；本地直连时留空） ----
# 飞书 API 与长连接经此代理，只挂在 Friday 自己的 HTTP 客户端上，不污染 shell。
# 密码里的 + 要写成 %2B。例如 http://user:password@proxy.example.com:3128
FRIDAY_FEISHU_PROXY=
# dsh 子进程默认不走代理；要让 dsh 的 web 工具出网时设为 1，并同时提供 HTTPS_PROXY。
FRIDAY_DSH_PROXY=0
#HTTPS_PROXY=http://user:password@proxy.example.com:3128

# ---- 模型（dsh 侧读取） ----
DEEPSEEK_API_KEY=sk-xxx
# 自建模型网关时填这里；不设时走官方 API（https://api.deepseek.com/anthropic）
# dsh 的 llm-deepseek 默认 Messages 协议，根必须以 /anthropic 结尾
#DEEPSEEK_BASE_URL=https://llm-gateway.example.com/anthropic
# 旧 Agent 默认与独立 router 的兼容配置；不用于激活空间主模型选择。
FRIDAY_MODEL_PROVIDER=deepseek-official
FRIDAY_MODEL=deepseek-flash
# ACP worker 实际默认；升级前先核对旧部署的实际 ACP 选择，再显式保留。
FRIDAY_ACP_MODEL_PROVIDER=deepseek-official
FRIDAY_ACP_MODEL=deepseek-v4-flash
# 非秘密账户引用，不是凭据，也不代表飞书发起人付费。
FRIDAY_MODEL_ACCOUNT=deployment
# 默认只允许以上一个路由。扩展时使用 JSON，必须含默认路由与对应 accountRef。
#FRIDAY_ALLOWED_MODELS=[{"providerId":"deepseek-official","modelId":"deepseek-v4-flash","accountRef":"deployment"}]

# ---- dsh ----
# dsh 可执行文件（npm i -g @deepseek-ai/dsh 后在 PATH 里）
DSH_COMMAND=dsh
# Friday 专用的 dsh home，和你本机 ~/.dsh 分开
DSH_HOME=/home/<you>/.friday/dsh
DSH_PROFILE=friday
# 公开部署必须显式启用。默认 false 保留内部部署行为；仅接受 true/false/1/0，其他值拒绝启动。
# true：普通用户及全部无人值守任务只用经过配置校验的 managed；准备失败即失败，不降级 workspace。
FRIDAY_PUBLIC_MODE=false
# 公开模式非管理员每天可启动的新任务数，按北京时间零点更新；后台任务记在委托人名下。
# 默认 unlimited 不限；正整数=每日上限，0=不启动新任务；同次任务收尾/轮末反思不重复扣次。
# 这是任务次数而非 token/费用预算；达到上限不自动排到次日，查看进度与停止仍可用。
FRIDAY_PUBLIC_DAILY_TASKS=unlimited
# 内部部署的默认执行模式；公开模式下仅管理员的交互任务遵循此值。
# managed 只提供 Friday 的受控 MCP 工具，不提供原生 shell/文件工具，不代表 OS 隔离。
FRIDAY_DEFAULT_EXECUTION=workspace
# read-only | workspace-write | danger-full-access —— P0 建议 workspace-write
# 注意：workspace-write 需要沙箱后端（Linux: bwrap 或 Landlock≥5.13；macOS: seatbelt）。开发机容器里两者都没有时，
# dsh 会拒绝每条 bash 命令、模型带 sandbox_permissions=danger-full-access 重试、Friday 收到升级请求：
# 可信用户（FRIDAY_TRUSTED_USERS）自动放行，其他人发卡片点"允许"。不想要这一来一回，就改成 danger-full-access（无沙箱、无确认）。
DSH_PERMISSION_MODE=workspace-write

# ---- 工作区（沙箱 cwd） ----
# 每个群一个子目录：<root>/chats/<chat_id>，共享 repos 目录以只读符号链接挂入
FRIDAY_WORKSPACE_ROOT=/home/<you>/.friday/workspaces

# ---- 网关内部 API（只监听本机；MCP 工具通过它访问飞书） ----
FRIDAY_API_HOST=127.0.0.1
FRIDAY_API_PORT=7788

# ---- 策略 ----
# safe: 读类工具自动放行，写/执行类升级请求发卡片让人点；auto: 全部放行；deny: 全部拒绝
FRIDAY_PERMISSION_POLICY=safe
FRIDAY_PERMISSION_TIMEOUT_MS=600000
# 可信用户（open_id，逗号分隔）：他们发起的任务里，跑命令/改文件的升级请求自动放行（日志和任务卡片里仍能看到命令）；
# 别人发起的要在卡片上点"允许"，且只有发起人或可信用户点了才算。open_id 可以在 friday.log 的 task queued 日志里看到。
FRIDAY_TRUSTED_USERS=
# 全局管理员（open_id，逗号分隔）：可以把记忆晋升到企业层（org）、改任何空间的配置。不填则沿用 FRIDAY_TRUSTED_USERS。
FRIDAY_ADMINS=
# 只在这些群响应（逗号分隔 chat_id）；留空 = 所有已加入的群
FRIDAY_ALLOWED_CHATS=
# 以下几项是**部署级默认值**，每个空间的负责人可以用 !space set 覆盖（只存和默认值不同的部分）。
# 任务跑了这么久（毫秒）还没结束才发进度卡片（工具进度、等待确认）；普通问答几秒回完就只有一条普通消息。0 = 一开始就发
FRIDAY_PROGRESS_CARD_DELAY_MS=4000
# 贴在原消息上的表情：收到,完成,失败（飞书 emoji_type，见《表情文案说明》）；off 关闭；某一位留空则不贴
# 默认 OnIt（"在做了"）,DONE（✅）,CrossMark（❌）；想要 👀 可改成 GLANCE,DONE,CrossMark
FRIDAY_REACTIONS=OnIt,DONE,CrossMark
# 个人授权（私聊 !connect）：回调地址要登记到开发者后台「安全设置 → 重定向 URL」；申请的用户权限要在「权限管理」的用户列开通
# 面向他人使用时必须配置浏览器可达、已加入飞书白名单的 HTTPS 回调；本机地址不是公网回调
# 公网中转部署见 cloudflare/friday-oauth；先加白名单再切换服务端地址，不能把带 code/state 的地址发到群里
#FRIDAY_OAUTH_REDIRECT_URI=https://your-friday-oauth.example/oauth/callback
# 默认 core 含文档读写；watch / calendar / minutes 仅按需申请，实际可用范围以返回的 scope 和资源权限为准
#FRIDAY_USER_SCOPE_EXTRAS=watch,calendar,minutes
#FRIDAY_USER_SCOPES=offline_access contact:user.base:readonly im:chat:readonly im:message:readonly search:message docx:document:readonly docx:document im:resource im:message.p2p_msg:get_as_user wiki:wiki:readonly wiki:node:read drive:drive.metadata:readonly
# 拼文档链接用的租户域名（建文档后回复里的链接），如 xxx.feishu.cn；不填用 feishu.cn
#FRIDAY_DOC_DOMAIN=
# 轮末记忆整理：每轮答完后在同一会话里追加一轮，让模型把值得长期记住的存下来（on|off）；没用工具时回答至少多长才做
FRIDAY_REFLECT=on
FRIDAY_REFLECT_MIN_CHARS=200
# 夜间整理：每天几点把各空间攒下的"待确认"记忆过一遍（合并重复、删没价值的、挑出值得确认的），0-23，off 关闭
FRIDAY_CONSOLIDATE_HOUR=3
# 群级主动模式的节奏（按群 !proactive on 开启）：安静多久后看一眼、至少积累几条、每群每小时最多主动说几次、连续几次没事可做就休眠
FRIDAY_PROACTIVE_QUIET_MS=180000
FRIDAY_PROACTIVE_MIN_MESSAGES=3
FRIDAY_PROACTIVE_MAX_PER_HOUR=2
FRIDAY_PROACTIVE_DORMANT_AFTER=5
# 第一次被拉进群时默认开主动模式，开启人记为拉群的人（on|off）；开过又关掉的群、已有空间的群不受影响
FRIDAY_PROACTIVE_DEFAULT_ON=on
# 主动巡检时给明确有用的消息点赞：每群每天最多几个（0 = 不点赞）、贴哪个表情（飞书 emoji_type）
FRIDAY_KUDOS_MAX_PER_DAY=3
FRIDAY_KUDOS_EMOJI=THUMBSUP
# 单次历史拉取上限
FRIDAY_MAX_HISTORY=500
# 单个任务最长运行时间
FRIDAY_PROMPT_TIMEOUT_MS=1200000
# 自然语言入站分类：独立无工具进程；模型默认沿用工作模型。
#FRIDAY_ROUTER_MODEL_PROVIDER=deepseek-official
#FRIDAY_ROUTER_MODEL=deepseek-flash
FRIDAY_ROUTER_TIMEOUT_MS=15000

# ---- 数据 ----
FRIDAY_DB=/home/<you>/.friday/friday.db
LOG_LEVEL=info

# ---- GitHub 身份（以 GitHub App 身份行动，token 只在网关）----
# 在 GitHub 组织里创建 App（权限：Contents read/write、Issues read/write、Pull requests read/write、Metadata read），安装到需要的仓库
#GITHUB_APP_ID=123456
#GITHUB_APP_PRIVATE_KEY_PATH=/home/you/.friday/github-app.pem   # chmod 600
# 兜底的 installation（找不到仓库 owner 对应的安装时用）；App 装在多个账号上时网关会按 owner 自动选
#GITHUB_APP_INSTALLATION_ID=78901234
# 过渡期没有 App 时可用个人 token（所有动作会显示成这个人做的，只建议跑通读接口）
#GITHUB_TOKEN=ghp_xxx
# 允许读取的仓库，逗号分隔；留空 = App 安装到哪就能读哪，不授予写权限
FRIDAY_GITHUB_REPOS=your-org/your-repo
# 可写仓库单独授权；未配置或留空都禁写（Issue、评论、分支和 PR）。不能超出上面的读取范围。
#FRIDAY_GITHUB_WRITE_REPOS=your-org/approved-repo
# 修复者写侧的仓库镜像缓存目录（默认 $FRIDAY_HOME/git）
#FRIDAY_GIT_CACHE=
# 出网代理默认复用 FRIDAY_FEISHU_PROXY；要单独指定用 FRIDAY_GITHUB_PROXY

# 私聊使用本人的 GitHub App 用户授权，独立于上面的团队身份；不回退到部署凭据。
# GitHub App 的 Client ID 和 Client secret，非 App ID / installation token。
# 回调添加到 GitHub App: <FRIDAY_OAUTH_RELAY_URL>/github/callback
#FRIDAY_GITHUB_CLIENT_ID=Iv23xxxxxxxxxxxxxxxx
#FRIDAY_GITHUB_CLIENT_SECRET=
#FRIDAY_GITHUB_APP_SLUG=your-app-slug
# 用户 token 用数据库旁的 connection.key 加密。密钥文件只允许服务账号读取；恢复数据库时需单独恢复密钥。

# ---- 本人 Gmail（不配置时隐藏入口，不影响飞书和 GitHub） ----
# Google Cloud 启用 Gmail API，创建 Web application OAuth client。
# 回调添加为 <FRIDAY_OAUTH_RELAY_URL>/gmail/callback，relay 需部署包含 Gmail 回调的版本。
# 先申请 openid/email/gmail.readonly；本人选择允许发送时才补充 gmail.send。
# OAuth 测试模式仅允许名单内账号，公开使用前完成 Google 要求的验证。
#FRIDAY_GOOGLE_CLIENT_ID=123456-example.apps.googleusercontent.com
#FRIDAY_GOOGLE_CLIENT_SECRET=
# 配置工具：python3 scripts/configure-google-personal.py --host <host> --client-id <id>
# 密钥仅在终端隐藏输入。Gmail token 复用 connection.key，独立按用户和用途加密。

# 需求投票。on 才注册投票工具/路由；各群仍需负责人开启。默认 off。
FRIDAY_POLLS=off
# 会议旁听。on 才构造会议运行时/路由；空间开关缺省关。默认 off。
FRIDAY_MEETINGS=off

# ---- 自己开的 PR 的跟进 ----
# review 超时分两档，都从 Friday 第一次看见 PR 就绪起算、各提醒一次：
# 第一档：就绪多久还没人 review，在开 PR 的原会话 @ 发起人提醒（毫秒，默认 12 小时；0 = 不提醒，第二档也随之不升级）
#FRIDAY_PR_REVIEW_OVERDUE_MS=43200000
# 第二档：第一档提醒过之后仍没人 review、就绪满多久，在同一会话 @ 空间负责人升级一次（毫秒，默认 48 小时；0 = 不升级）
FRIDAY_PR_REVIEW_ESCALATE_MS=172800000
# PR 合并后进入某个已发布版本时，原会话总会收到一句"已进入 vX"。
# on 时再按案件关联的 Issue（PR 关闭的 Issue）找到 bug_reports 的原会话，各回告一次并 @ 报障人；默认 off。
FRIDAY_RELEASE_REPORTER_NOTICES=off
# Friday 自己建的 Issue 正文里维护唯一的受影响人数块：关联案件里已核实的真人报告人去重计数，
# 每 10 分钟看一次，人数变了才读写 GitHub；块被人改过、删掉或标记不成对就停止维护该 Issue。只写上面可写名单里的仓库。默认 off。
FRIDAY_ISSUE_AFFECTED_COUNT=off
